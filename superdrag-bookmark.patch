+  }
+  const SIZE_T bytes = (text.size() + 1) * sizeof(wchar_t);
+  HGLOBAL memory = GlobalAlloc(GMEM_MOVEABLE, bytes);
+  if (!memory) {
+    CloseClipboard();
+    return false;
+  }
+  void* locked = GlobalLock(memory);
+  if (!locked) {
+    GlobalFree(memory);
+    CloseClipboard();
+    return false;
